    private static DeltaMatroide iniciaEjecucionConsola(boolean[] parametrosEjecucion) {
       DeltaMatroide delta = null;
       Flujos Flujo=new Flujos();
       
        //construid DeltaMatroide
            byte[][] mat=null;
            if(parametrosEjecucion[0]){
                if(0<nombresArchivos[0].length()){
                    try {
                        mat=Flujo.leerMatriz(nombresArchivos[0]);
                    } catch (IOException ex) {
                        System.out.println("Error Al Abrir Archivo");
                    }
               }else System.out.println("No introduciste el nombre del Archivo");
               
           }else {
               System.out.println("Introduce el tamaño N de la matriz seguido de los NxN terminos");
               Scanner leer=new Scanner(System.in);

                int n=leer.nextInt();
                mat=new byte[n][n];
                for(int i=0;i<n;i++) for(int j=0;j<n;j++) mat[i][j]=leer.nextByte();  
           }
           
           ParValidacion valida=new ParValidacion();
           Validar obAux=new Validar(); 
        if(!parametrosEjecucion[1]) valida=obAux.validarMatrizAdyacencia(mat);
        
            System.out.print("\nAnalizar matriz en GF2 o GF3?\nTeclea 2 para GF2 o 3 para GF3: ");
            Scanner leer =new Scanner (System.in);
            int res=leer.nextInt();
            while(res!=2 && res!=3){
                System.out.print("Parametro incorrecto\nTeclea 2 para GF2 o 3 para GF3: ");
                res=leer.nextInt();
            }
            valida.setValidaEnSuTipo(true);
            if(res==2) valida.setTipoMatriz(true);
            else valida.setTipoMatriz(false);
            
        
            String param="";
            if(valida.isValidaEnSuTipo() && mat!=null){
                System.out.println("la matriz Introducida es:");
                imp.ImprimeMatrizNxN(mat);
                
                if(valida.isTipoMatriz()) System.out.println("La Matriz Se Analizara en Modulo 2");
               else System.out.println("La Matriz se Analizara en Modulo 3");
                DeltaMatroide deltaMat=new DeltaMatroide(mat,valida.isTipoMatriz());
                if(parametrosEjecucion[3]) deltaMat.setModo(false);
                presentaResultados(deltaMat);
            }else{
                if(mat!=null){
                    switch(valida.getParamError()){
                        case "ij!=ji":
                            param="\nAij es diferenta de Aji";
                        case "noGrafo":
                            param="\nMatriz con Valores diferentes de 1's y 0's";
                        case "diagonal":
                            param="\nMatriz Antisimetrica no contiene terminos Diferentes a 0 en la diagonal";
                        case "ij!=-ji":
                            param="\nAij es diferenta de -Aji";
                  }
                }
                System.out.println("La matriz intoducida no es Valida"+param);
          
            }
           
       
    return delta;
    }

